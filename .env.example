# PostgreSQL. With docker-compose.yml as-is:
DATABASE_URL="postgresql://pouls:pouls@localhost:5432/pouls?schema=public"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"

# Dev-only demo login (Credentials provider). Never set this in production —
# see src/lib/auth.ts. Leave unset once Entra ID / Google are configured below.
ENABLE_DEMO_LOGIN="true"

# Passwordless e-mail sign-in (src/lib/magicLink.ts) — the primary auth
# method when the org has no managed SSO (e.g. personal e-mail addresses).
# Always active; without RESEND_API_KEY the link is just printed to the
# server console instead of e-mailed (fine for local dev, not for prod).
# Also used for the weekly reminder e-mails below.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Pouls <onboarding@resend.dev>"

# Microsoft Entra ID SSO (optional, only if the org actually has it). Leave blank to disable the provider.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Google Workspace SSO (optional, only if the org actually has it). Leave blank to disable the provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Weekly reminders (optional)
CRON_SECRET="change-me"
TEAMS_WEBHOOK_URL=""
